config SHIELD_HALCYON_SOFLE_V2
    bool

config SHIELD_HALCYON_SOFLE_V2_LEFT
    def_bool $(shields_list_contains,halcyon_sofle_v2_left)
    select SHIELD_HALCYON_SOFLE_V2

config SHIELD_HALCYON_SOFLE_V2_RIGHT
    def_bool $(shields_list_contains,halcyon_sofle_v2_right)
    select SHIELD_HALCYON_SOFLE_V2

config SHIELD_HALCYON_SOFLE_V2_DONGLE
    def_bool $(shields_list_contains,halcyon_sofle_v2_dongle)
